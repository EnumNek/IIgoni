# Пример настроек для локального запуска (скопируйте в .env или экспортируйте в shell)
DATABASE_URL=postgresql+psycopg://transport:transport@localhost:5432/transport
# DATABASE_URL=sqlite:///data/transport.db
INTEGRATION_MODE=auto          # auto | stub | real
# NETWORK_PATH=../sim/data/network.json
# OSM_PATH=../map.osm
CORS_ORIGINS=*
SEED_BASE_FORECAST=1
