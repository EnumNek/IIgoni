  <tag k="description" v="Композиция состоит из двух фигур великих поэтов Абая и Пушкина и символизирует дружбу между двумя народами. Дерево высотой 5,2 м, объединяющее обе фигуры как символ вечности, в то же время разъединяет эпоху творений этих выдающихся личностей."/>
  <tag k="historic" v="monument"/>
  <tag k="name" v="Абай и Пушкин"/>
  <tag k="tourism" v="attraction"/>
  <tag k="wheelchair" v="yes"/>
 </node>
